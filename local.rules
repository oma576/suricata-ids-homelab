# Custom Suricata rules - Suricata IDS Home Lab
# Custom SIDs use the 1000000+ range to avoid clashing with published rulesets.

# Detects ping (ICMP echo request, type 8). Used to verify the sensor sees live traffic.
alert icmp any any -> any any (msg:"LAB - ICMP Ping Detected"; itype:8; sid:1000001; rev:1;)

# Detects TCP SYN port scans (e.g. nmap -sS): 5+ SYN packets from one source within 10 seconds.
# rev:1 used "type threshold" -> hundreds of duplicate alerts per scan.
# rev:2 uses "type both" -> alert once per source per window (reduces alert fatigue).
alert tcp any any -> $HOME_NET any (msg:"LAB - Nmap Stealth Scan Detected"; flags:S; threshold: type both, track by_src, count 5, seconds 10; sid:1000002; rev:2;)
